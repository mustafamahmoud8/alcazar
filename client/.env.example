# Client Environment Variables
# Copy this file to .env.local and fill in your values

# API
NEXT_PUBLIC_SERVER_URL=http://localhost:3000/api

# Pages
NEXT_PUBLIC_HOME_PAGE=/
NEXT_PUBLIC_SHOP_PAGE=/shop
NEXT_PUBLIC_DASHBOARD_PAGE=/dashboard
NEXT_PUBLIC_CART_PAGE=/cart
NEXT_PUBLIC_LOGIN_PAGE=/login
NEXT_PUBLIC_REGISTER_PAGE=/register
NEXT_PUBLIC_FORGOT_PASSWORD_PAGE=/forgotPassword
NEXT_PUBLIC_PROFILE_PAGE=/profile
NEXT_PUBLIC_ABOUT_PAGE=/about
NEXT_PUBLIC_CONTACT_PAGE=/contact

# Social Media
NEXT_PUBLIC_OFFICIAL_FACEBOOK=https://facebook.com/alcazar
NEXT_PUBLIC_OFFICIAL_INSTAGRAM=https://instagram.com/alcazar
NEXT_PUBLIC_OFFICIAL_PINTEREST=https://pinterest.com/alcazar

# Messages
NEXT_PUBLIC_SESSION_EXPIRED_MESSAGE=UnAuthorized
