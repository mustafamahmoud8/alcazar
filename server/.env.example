# Server Environment Variables
# Copy this file to .env and fill in your values

PORT=3000

# MongoDB
DB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>

# JWT
SECRET_KEY=your_super_secret_key_here

# Client URLs
CLIENT_URL=http://localhost:4500
CLIENT_GOOGLE_AUTH_URL=http://localhost:4500/auth-provider
CLIENT_THANKS_FOR_SUBSCRIPTION_URL=http://localhost:4500/subscription-thanks
CLIENT_SHOP_URL=http://localhost:4500/shop
CLIENT_ABOUT_URL=http://localhost:4500/about
CLIENT_CONTACT_URL=http://localhost:4500/contact

# Session
SESSION_EXPIRED_MESSAGE=Your session has expired, please log in again

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
CALLBACK_GOOGLE_URL=http://localhost:3000/api/auth/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Gmail App Password)
OFFICIAL_EMAIL=your_email@gmail.com
OFFICIAL_EMAIL_APP_PASSWORD=your_app_password
